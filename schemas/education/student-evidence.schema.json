{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Student Evidence",
  "description": "Learning evidence separated from interpretation and intervention",
  "type": "object",
  "properties": {
    "student": {"type": "string"},
    "context": {"type": "object"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {"type": "string"},
          "observation": {"type": "string"},
          "confidence": {"type": "number"}
        }
      }
    },
    "ability_model": {"type": "object"},
    "intervention": {"type": "object"}
  },
  "required": ["student", "evidence"]
}