{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Market Research",
  "description": "Evidence-based market analysis structure",
  "type": "object",
  "properties": {
    "market": {"type": "string"},
    "facts": {"type": "array"},
    "competitors": {"type": "array"},
    "customer_signals": {"type": "array"},
    "opportunities": {"type": "array"},
    "risks": {"type": "array"},
    "confidence": {"type": "string"}
  },
  "required": ["market"]
}